# NASM-syntax directive/mnemonic dictionary for fuzz_nasm.
# Preprocessor directives (macro engine -- the primary attack surface).
"%define"
"%xdefine"
"%undef"
"%assign"
"%macro"
"%imacro"
"%endmacro"
"%rep"
"%endrep"
"%exitrep"
"%rotate"
"%if"
"%ifdef"
"%ifmacro"
"%ifctx"
"%ifidn"
"%ifnum"
"%ifstr"
"%elif"
"%else"
"%endif"
"%include"
"%push"
"%pop"
"%repl"
"%error"
"%warning"
"%fatal"
"%line"
"%use"
"%strlen"
"%substr"
"%local"
# Section / storage directives.
"section"
"segment"
"global"
"extern"
"common"
"absolute"
"bits"
"default"
"org"
"align"
"struc"
"endstruc"
"istruc"
"iend"
"at"
"times"
"incbin"
"equ"
